<?xml version="1.0"?>
<!--
  LiDAR を載せた 2 輪ロボット（参考: 2DRoboPrac_ws の models/LidarRobo/model.sdf）
  - 左右の車輪を DiffDrive プラグインで動かす（/cmd_vel で速度を指令）
  - 屋根の上に 360 度の 2D LiDAR（/scan）
  - OdometryPublisher プラグインで、ロボットの位置と向きを /odom に出す
  胴体は半径 0.2 m の円柱（Q 学習の 2D シミュレータでも半径 0.2 m の円として扱う）
-->
<sdf version="1.9">
  <model name="lidar_bot">

    <link name="base_link">
      <!-- base_link の原点は車軸の高さ（地面から 0.05 m） -->
      <pose>0 0 0.05 0 0 0</pose>
      <inertial>
        <pose>0 0 0.04 0 0 0</pose>
        <mass>3.0</mass>
        <inertia>
          <ixx>0.035</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.035</iyy><iyz>0</iyz>
          <izz>0.06</izz>
        </inertia>
      </inertial>

      <!-- 胴体（オレンジの円柱） -->
      <collision name="body_collision">
        <pose>0 0 0.06 0 0 0</pose>
        <geometry><cylinder><radius>0.20</radius><length>0.10</length></cylinder></geometry>
      </collision>
      <visual name="body_visual">
        <pose>0 0 0.06 0 0 0</pose>
        <geometry><cylinder><radius>0.20</radius><length>0.10</length></cylinder></geometry>
        <material>
          <ambient>0.95 0.50 0.10 1</ambient><diffuse>0.95 0.50 0.10 1</diffuse><specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>
      <!-- 前を示す目印（白い板） -->
      <visual name="front_mark_visual">
        <pose>0.13 0 0.112 0 0 0</pose>
        <geometry><box><size>0.08 0.16 0.006</size></box></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
      </visual>

      <!-- キャスター（前後。摩擦ゼロの球） -->
      <collision name="caster_front_collision">
        <pose>0.14 0 -0.025 0 0 0</pose>
        <geometry><sphere><radius>0.025</radius></sphere></geometry>
        <surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface>
      </collision>
      <collision name="caster_back_collision">
        <pose>-0.14 0 -0.025 0 0 0</pose>
        <geometry><sphere><radius>0.025</radius></sphere></geometry>
        <surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface>
      </collision>

      <!-- LiDAR の本体（見た目） -->
      <visual name="lidar_visual">
        <pose>0 0 0.135 0 0 0</pose>
        <geometry><cylinder><radius>0.04</radius><length>0.05</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.12 1</ambient><diffuse>0.1 0.1 0.12 1</diffuse></material>
      </visual>

      <!-- 2D LiDAR: 360 度を 1 度おきに測る。1 秒に 10 回 -->
      <sensor name="lidar" type="gpu_lidar">
        <pose>0 0 0.14 0 0 0</pose>
        <topic>/scan</topic>
        <update_rate>10</update_rate>
        <always_on>1</always_on>
        <visualize>true</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.12</min>
            <max>8.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>
    </link>

    <!-- 左の車輪 -->
    <link name="left_wheel">
      <pose relative_to="base_link">0 0.17 0 -1.5708 0 0</pose>
      <inertial>
        <mass>0.3</mass>
        <inertia>
          <ixx>0.0002</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0002</iyy><iyz>0</iyz>
          <izz>0.0004</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.05</radius><length>0.03</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.05</radius><length>0.03</length></cylinder></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
    </link>
    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>

    <!-- 右の車輪 -->
    <link name="right_wheel">
      <pose relative_to="base_link">0 -0.17 0 -1.5708 0 0</pose>
      <inertial>
        <mass>0.3</mass>
        <inertia>
          <ixx>0.0002</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0002</iyy><iyz>0</iyz>
          <izz>0.0004</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.05</radius><length>0.03</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.05</radius><length>0.03</length></cylinder></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
    </link>
    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>

    <!-- 差動二輪の駆動: /cmd_vel（前に進む速さと回る速さ）を受けて、左右の車輪を回す -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.34</wheel_separation>
      <wheel_radius>0.05</wheel_radius>
      <topic>/cmd_vel</topic>
    </plugin>

    <!-- ロボットの位置と向きを /odom に出す（Gazebo が知っている正確な値） -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_publish_frequency>20</odom_publish_frequency>
      <odom_topic>/odom</odom_topic>
      <dimensions>2</dimensions>
    </plugin>
  </model>
</sdf>
