<?xml version="1.0"?>
<!--
  スタートからゴールまでの間に障害物を置いたワールド
  （参考: 2DRoboPrac_ws の models/worlds/nav_slam.sdf）

  スタート（緑の円）: (0, 0)    ゴール（赤の円と風船）: (10, 0)
  障害物: 壁 2 枚と柱 1 本（Q 学習の 2D シミュレータ sim2d.py の GAZEBO_LAYOUT と同じ配置）
  ロボットは launch ファイルからスタート地点に出す（スポーンする）
-->
<sdf version="1.9">
  <world name="goal_world">
    <physics name="2ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <!-- LiDAR とカメラを使うのに必要なプラグイン -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.70 0.82 0.95 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.9 0.9 0.88 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.4 -0.9</direction>
    </light>

    <!-- 床 -->
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material>
            <ambient>0.80 0.80 0.78 1</ambient><diffuse>0.80 0.80 0.78 1</diffuse><specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
        <!-- コースの範囲（色を少し変えただけ。見た目のみ） -->
        <visual name="course">
          <pose>5 0 0.001 0 0 0</pose>
          <geometry><box><size>13 5 0.002</size></box></geometry>
          <material>
            <ambient>0.68 0.74 0.80 1</ambient><diffuse>0.68 0.74 0.80 1</diffuse><specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- スタート（緑の円。見た目だけで、ぶつからない） -->
    <model name="start_marker">
      <static>true</static>
      <pose>0 0 0.003 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.35</radius><length>0.006</length></cylinder></geometry>
          <material><ambient>0.15 0.70 0.25 1</ambient><diffuse>0.15 0.70 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ゴール（赤の円と、その上に浮かぶ風船。風船は LiDAR の高さより上なので障害物として見えない） -->
    <model name="goal_marker">
      <static>true</static>
      <pose>10 0 0.003 0 0 0</pose>
      <link name="link">
        <visual name="disk">
          <geometry><cylinder><radius>0.35</radius><length>0.006</length></cylinder></geometry>
          <material><ambient>0.85 0.12 0.12 1</ambient><diffuse>0.85 0.12 0.12 1</diffuse></material>
        </visual>
        <visual name="balloon">
          <pose>0 0 1.0 0 0 0</pose>
          <geometry><sphere><radius>0.15</radius></sphere></geometry>
          <material><ambient>0.95 0.15 0.15 1</ambient><diffuse>0.95 0.15 0.15 1</diffuse><specular>0.6 0.6 0.6 1</specular></material>
        </visual>
        <visual name="string">
          <pose>0 0 0.6 0 0 0</pose>
          <geometry><cylinder><radius>0.004</radius><length>0.6</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 障害物 1: 壁（長さ 2.4 m） -->
    <model name="wall_1">
      <static>true</static>
      <pose>3.3 -0.2 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.5 2.4 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 2.4 0.5</size></box></geometry>
          <material><ambient>0.22 0.27 0.36 1</ambient><diffuse>0.22 0.27 0.36 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 障害物 2: 壁（長さ 2.4 m） -->
    <model name="wall_2">
      <static>true</static>
      <pose>5.8 1.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.5 2.4 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 2.4 0.5</size></box></geometry>
          <material><ambient>0.22 0.27 0.36 1</ambient><diffuse>0.22 0.27 0.36 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 障害物 3: 柱（半径 0.35 m） -->
    <model name="pillar">
      <static>true</static>
      <pose>8.3 -0.4 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.35</radius><length>0.6</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.35</radius><length>0.6</length></cylinder></geometry>
          <material><ambient>0.22 0.27 0.36 1</ambient><diffuse>0.22 0.27 0.36 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 動画撮影用のカメラ（コースの横の高いところから見下ろす）。録画するときだけ使う -->
    <model name="video_camera">
      <static>true</static>
      <pose>5 -7.5 6.2 0 0.69 1.5708</pose>
      <link name="link">
        <sensor name="video_camera" type="camera">
          <topic>/video_camera/image</topic>
          <update_rate>30</update_rate>
          <always_on>1</always_on>
          <camera>
            <horizontal_fov>1.1</horizontal_fov>
            <image><width>1280</width><height>720</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>100</far></clip>
          </camera>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
